+void QuicSentPacketManager::SetBrutalSendRate(uint64_t bytes_per_second) {
+  const bool was_enabled = brutal_send_rate_bps_ > 0;
+  brutal_send_rate_bps_ = bytes_per_second;
+  if (send_algorithm_ != nullptr &&
+      send_algorithm_->GetCongestionControlType() == kBrutal) {
+    ApplyBrutalSendRate();
+    if (was_enabled && brutal_send_rate_bps_ == 0) {
+      pacing_sender_.SetBurstTokens(10);
+    }
+    if (network_change_visitor_ != nullptr) {
+      network_change_visitor_->OnCongestionChange();
+    }
+  }
+}
+
+void QuicSentPacketManager::ApplyBrutalSendRate() {
+  if (send_algorithm_ == nullptr ||
+      send_algorithm_->GetCongestionControlType() != kBrutal) {
+    return;
+  }
+  auto* brutal = static_cast<BrutalSender*>(send_algorithm_.get());
+  brutal->SetPeerMaxAckDelay(peer_max_ack_delay_);
+  brutal->SetTargetRateBps(brutal_send_rate_bps_);
+  if (brutal_send_rate_bps_ > 0) {
+    // Disable unpaced quiescence bursts so pacing shapes short and low-RTT
+    // transfers accurately at the configured target rate.
+    pacing_sender_.set_remove_non_initial_burst();
+    pacing_sender_.SetBurstTokens(0);
+  }
 }
 
