+// Thread-safe registry mapping a live QuicChromiumClientSession's NetLog source
+// ID (`socket_log_id`) to its `(1ULL << 63) | n` transport connection_id.
+struct QuicSessionConnectionIdRegistry {
+  base::Lock lock;
+  std::unordered_map<uint32_t, uint64_t> by_log_id;
+};
+
+QuicSessionConnectionIdRegistry& GetQuicSessionConnectionIdRegistry() {
+  static base::NoDestructor<QuicSessionConnectionIdRegistry> registry;
+  return *registry;
+}
+
+uint64_t NextQuicTransportConnectionId() {
+  static std::atomic<uint64_t> next_id{1};
+  constexpr uint64_t kQuicConnectionIdBit = uint64_t{1} << 63;
+  return kQuicConnectionIdBit |
+         (next_id.fetch_add(1, std::memory_order_relaxed) &
+          ~kQuicConnectionIdBit);
+}
+
+void RegisterQuicSessionLogId(uint32_t log_id, uint64_t connection_id) {
+  if (log_id == 0 || connection_id == 0) {
+    return;
+  }
+  auto& reg = GetQuicSessionConnectionIdRegistry();
+  base::AutoLock guard(reg.lock);
+  reg.by_log_id[log_id] = connection_id;
+}
+
+void UnregisterQuicSessionLogId(uint32_t log_id) {
+  if (log_id == 0) {
+    return;
+  }
+  auto& reg = GetQuicSessionConnectionIdRegistry();
+  base::AutoLock guard(reg.lock);
+  reg.by_log_id.erase(log_id);
+}
+
 }  // namespace
 
+uint64_t LookupQuicSessionConnectionIdByLogId(uint32_t socket_log_id) {
+  if (socket_log_id == 0) {
+    return 0;
+  }
+  auto& reg = GetQuicSessionConnectionIdRegistry();
+  base::AutoLock guard(reg.lock);
+  auto it = reg.by_log_id.find(socket_log_id);
+  return it != reg.by_log_id.end() ? it->second : 0;
+}
