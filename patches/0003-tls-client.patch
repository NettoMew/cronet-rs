+scoped_refptr<base::SingleThreadTaskRunner>
+Cronet_EngineImpl::GetNetworkTaskRunner() {
+  {
+    base::AutoLock lock(lock_);
+    if (!context_) {
+      return nullptr;
+    }
+  }
+  init_completed_.Wait();
+  base::AutoLock lock(lock_);
+  return context_ ? context_->network_task_runner() : nullptr;
+}
+
+bool Cronet_EngineImpl::ConfigureTls(const Cronet_TlsConfig& config,
+                                     char* err_buf,
+                                     size_t err_len) {
+  CHECK(!context_);
+  auto parsed = std::make_unique<OwnedTlsConfig>();
+  std::string error;
+  if (!ParseAndValidateTlsConfig(config, parsed.get(), &error)) {
+    if (err_buf && err_len > 0) {
+      size_t n = std::min(error.size(), err_len - 1);
+      UNSAFE_TODO(memcpy(err_buf, error.data(), n));
+      UNSAFE_TODO(err_buf[n]) = '\0';
+    }
+    return false;
+  }
+  tls_config_ = std::move(parsed);
+  return true;
+}
